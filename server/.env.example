# Server
PORT=5000
NODE_ENV=development

# Database (local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/vtag

# Auth - use a long random string in production (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Frontend origin (comma-separated list allowed)
CLIENT_URL=http://localhost:5173

# Development OTP: the 6-digit code is returned in the API response.
# Always disabled automatically when NODE_ENV=production.
DEV_OTP_ENABLED=true
OTP_TTL_MINUTES=5
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Telephony abstraction. Only "mock" is implemented in this MVP.
TELEPHONY_PROVIDER=mock
# Probability (0-1) that a simulated call fails to connect.
MOCK_CALL_FAILURE_RATE=0.15
